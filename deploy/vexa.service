; Vexa Mail Insight – systemd unit example.
;
; Install:
;   sudo cp deploy/vexa.service /etc/systemd/system/vexa.service
;   sudo systemctl daemon-reload
;   sudo systemctl enable --now vexa
;
; Update from the dashboard:
;   The Settings → Updates panel detects systemd via INVOCATION_ID and
;   exposes the "Apply update now" button. systemd's Restart=always
;   policy brings the process back up against the new build after the
;   self-update script terminates the old one.
;
; Adjust User, Group, WorkingDirectory, and EnvironmentFile to match
; your install layout. The user must own the working directory so
; `git pull` and `pnpm install` can write to it.
;
; This project builds with `output: standalone`, which `next start` refuses
; to serve. The unit runs the standalone server directly, and that server
; only serves what sits next to it — after every `pnpm run build`, assemble:
;   cp -r public .next/standalone/public
;   cp -r .next/static .next/standalone/.next/static
;   cp -r drizzle .next/standalone/drizzle
; HOSTNAME defaults to 0.0.0.0 in the standalone server; 127.0.0.1 below
; keeps the port loopback-only so it is reachable through the reverse proxy
; alone. Remove it only if the host firewall filters the port.

[Unit]
Description=Vexa Mail Insight (DMARC observability dashboard)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vexa
Group=vexa
WorkingDirectory=/opt/vexa-insight-dashboard
EnvironmentFile=-/opt/vexa-insight-dashboard/.env
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
ExecStart=/usr/bin/env node .next/standalone/server.js
Restart=always
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=30
LimitNOFILE=65535

; Next.js runs its graceful shutdown on SIGTERM and then exits 128+15 on
; purpose, so that Node reports a signal termination rather than a normal exit.
; Without this line systemd reads that 143 as a crash: every `systemctl stop`,
; every `restart`, and every dashboard-triggered update leaves the unit in
; "Failed with result 'exit-code'", which is misleading in `systemctl status`
; and false-alarms any monitoring that watches unit state.
SuccessExitStatus=143

; Hardening (safe defaults – tighten as your environment allows)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/vexa-insight-dashboard
ProtectHome=true

[Install]
WantedBy=multi-user.target
