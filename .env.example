# Vexa Mail Insight – environment configuration
#
# Quick start: NO .env required. Run `pnpm dev` and use the web installer
# at http://localhost:3000/install. SQLite is created at data/vexa.db.
#
# Copy this file to .env to override defaults or pre-seed configuration.
# Anything not set here can be configured in the Settings UI after install.

# --- Database ---
# SQLite file path. SQLite is the only supported database.
DATABASE_URL="file:./data/vexa.db"

# --- API key ---
# Used to authenticate POST /api/v1/admin/trigger-poll and other admin endpoints.
# Min 32 characters. Can also be generated/rotated from the Settings UI.
# SECRET_KEY=""

# --- IMAP ingestion (optional, can also be set in Settings UI) ---
# IMAP_SERVER=""
# IMAP_PORT="993"
# IMAP_USERNAME=""
# IMAP_PASSWORD=""

# --- Scheduler tuning ---
# INGESTION_INTERVAL_MINUTES="60"
# INGESTION_DAYS_BACK="7"

# --- Branding / runtime ---
# PROJECT_NAME="Vexa Mail Insight"
# ENVIRONMENT="production"

# --- IMAP diagnostics ---
# IMAP protocol traces contain subjects, addresses and Message-IDs, so debug
# and info output from the IMAP client is dropped by default. Set to "true"
# or "1" to send it to the console while diagnosing a connection.
# VEXA_IMAP_DEBUG="false"

# --- Update check (GitHub Releases) ---
# Disable the daily update check for airgapped deployments.
# Accepts: false, 0, no, off (any other value keeps it enabled).
# VEXA_UPDATE_CHECK_ENABLED="true"
# Override the upstream repo (use this when running a fork).
# Accepts "owner/repo" or a full GitHub URL.
# VEXA_UPDATE_REPO="VexaMail/vexa-insight"

# --- Install ---
# Restrict install to loopback (127.0.0.1 / localhost / ::1) by default.
# Set to "1" to allow install from any origin. Not recommended for fresh deploys
# reachable from the public internet — the one-time install token is the only
# gate when remote install is enabled.
# VEXA_ALLOW_REMOTE_INSTALL="0"

# --- CSRF / Server actions ---
# Comma-separated list of origins (scheme + host + optional port) that are
# allowed to invoke Next.js Server Actions. Read at request time (proxy.ts),
# so it can be set on a published image without rebuilding. The same-origin
# guard on API routes is automatic and does not need this list. Only needed
# when the reverse proxy does not forward the public hostname in
# Host/X-Forwarded-Host. Example: "https://dmarc.example.com"
# VEXA_ALLOWED_ORIGINS=""

# --- Development LLM backend (optional, macOS only) ---
# Routes Anthropic calls onto a Claude subscription OAuth token read from the
# macOS Keychain instead of the configured API key, so prompt work costs
# nothing while developing. Ignored unless NODE_ENV is exactly "development",
# so it can never take effect in a deployment. See
# docs/ai-max-oauth-backend.md.
# LLM_BACKEND="max-oauth"
