# Keep local state and secrets out of the image. The Dockerfile does
# `COPY . .`, so without this file a build from a configured checkout copies
# the live database (SECRET_KEY, encrypted IMAP password, ingested reports)
# and .env files into the published image.
data/
.env
.env.*

# Build artifacts and caches rebuilt inside the image
.next/
node_modules/
coverage/
out/
build/
dist/
.eslintcache
*.tsbuildinfo

# Local-only material
evals/results/
.git/
.github/
.claude/
.serena/
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
