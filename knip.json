{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "next.config.{js,mjs,cjs,ts}",
    "postcss.config.{js,mjs,cjs,ts}",
    "eslint.config.{js,mjs,cjs,ts}",
    "drizzle.config.ts",
    "vitest.config.ts",
    "vitest.a11y.config.ts",
    "app/**/page.tsx",
    "app/**/layout.tsx",
    "app/**/template.tsx",
    "app/**/loading.tsx",
    "app/**/error.tsx",
    "app/**/global-error.tsx",
    "app/**/not-found.tsx",
    "app/**/route.ts"
  ],
  "project": ["tsconfig.json"],
  "ignore": ["drizzle/**", "scripts/**"]
}
