{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@busirocket/tsconfig/nextjs.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@supabase/*": ["./src/services/supabase/*"]
    },
    "allowJs": false,
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", "scripts", "eslint.config.ts"]
}
