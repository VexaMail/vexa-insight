{
  "name": "vexa-mail-insight",
  "version": "0.2.0",
  "private": true,
  "description": "Open-source DMARC observability platform: ingest, normalize, and visualize email authentication reports (SPF, DKIM, DMARC) with a self-hostable Next.js dashboard.",
  "license": "Apache-2.0",
  "author": "Cristian Deluxe <me@cristiandeluxe.dev>",
  "homepage": "https://github.com/VexaMail/vexa-insight-dashboard#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VexaMail/vexa-insight-dashboard.git"
  },
  "bugs": {
    "url": "https://github.com/VexaMail/vexa-insight-dashboard/issues"
  },
  "keywords": [
    "dmarc",
    "spf",
    "dkim",
    "email-authentication",
    "email-security",
    "observability",
    "deliverability",
    "self-hosted",
    "nextjs",
    "drizzle",
    "sqlite"
  ],
  "scripts": {
    "dev": "next dev",
    "dev:max": "LLM_BACKEND=max-oauth next dev",
    "build": "next build",
    "build:dev": "next build",
    "start": "next start",
    "lint": "eslint . --cache --cache-location .eslintcache",
    "lint:fast": "oxlint --deny-warnings .",
    "lint:fix": "eslint . --fix --cache --cache-location .eslintcache",
    "format": "prettier --write . --list-different",
    "format:check": "prettier --check .",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.mts",
    "test:watch": "vitest --config vitest.config.mts",
    "test:a11y": "vitest run --config vitest.a11y.config.ts",
    "test:coverage": "vitest run --coverage --config vitest.config.mts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "backfill:rollup": "tsx scripts/backfill-rollup.ts",
    "eval:ai": "tsx scripts/run-ai-eval.ts",
    "check": "pnpm run type-check && pnpm run format && pnpm run lint:fix",
    "check:all": "pnpm run type-check && pnpm run format && pnpm run lint:fix && pnpm run test",
    "check:ci": "pnpm run lint:fast && pnpm run type-check && pnpm run lint && pnpm run format:check && pnpm run test && pnpm run check:migrations",
    "check:migrations": "bash scripts/check-migrations.sh",
    "perf:check": "pnpm build && lhci autorun --config=.lighthouserc.json",
    "smoke": "bash scripts/smoke.sh",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && lefthook install || echo 'prepare: not a git repository, skipping hook install'",
    "lint:suppress": "eslint . --suppress-all",
    "lint:prune": "eslint . --prune-suppressions",
    "dupes": "baseline-dupes . --threshold 2.9",
    "knip": "knip",
    "deps:graph": "depcruise app src scripts",
    "type-coverage": "baseline-type-coverage",
    "secrets:check": "gitleaks detect --no-banner --redact",
    "audit:check": "baseline-audit --level moderate",
    "check:quality": "pnpm knip && pnpm deps:graph && pnpm type-coverage",
    "check:security": "pnpm secrets:check && pnpm audit:check"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-avatar": "^1.2.4",
    "@radix-ui/react-dialog": "^1.1.21",
    "@radix-ui/react-popover": "^1.1.21",
    "@radix-ui/react-select": "^2.3.5",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.14",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.10.1",
    "framer-motion": "^12.42.2",
    "geoip-lite": "^2.0.3",
    "imapflow": "^1.5.0",
    "jsonrepair": "^3.15.0",
    "lucide-react": "^1.26.0",
    "next": "16.3.4",
    "node-cron": "^4.6.0",
    "react": "19.2.8",
    "react-country-flag": "^3.1.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "recharts": "^3.10.0",
    "semver": "^7.8.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "yauzl": "^3.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@busirocket/eslint-config": "^0.8.0",
    "@busirocket/prettier-config": "^0.2.0",
    "@busirocket/quality-config": "^0.11.0",
    "@busirocket/tsconfig": "^0.3.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@next/eslint-plugin-next": "^16.3.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/geoip-lite": "^1.4.4",
    "@types/node": "^26.1.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/semver": "^7.7.1",
    "@types/yauzl": "^3.4.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/eslint-plugin": "^1.6.27",
    "better-sqlite3": "^13.0.1",
    "dependency-cruiser": "^18.2.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.1.0",
    "eslint-plugin-code-policy": "^0.7.3",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-regexp": "^3.3.0",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-unicorn": "^72.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.12.0",
    "jiti": "^2.7.0",
    "jscpd": "^5.0.16",
    "jsdom": "^29.1.1",
    "knip": "^6.32.2",
    "lefthook": "^2.1.10",
    "oxlint": "^1.82.0",
    "prettier": "^3.9.6",
    "prettier-plugin-css-order": "^2.2.0",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.22.1",
    "type-coverage": "^2.30.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.11",
    "vitest-axe": "^0.1.0"
  },
  "packageManager": "pnpm@11.17.0"
}
