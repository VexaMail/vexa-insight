{
  "name": "vexa-mail-insight",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source DMARC observability platform: ingest, normalize, and visualize email authentication reports (SPF, DKIM, DMARC) with a self-hostable Next.js dashboard.",
  "license": "Apache-2.0",
  "author": "Cristian Deluxe <me@cristiandeluxe.dev>",
  "homepage": "https://github.com/VexaMail/vexa-insight-dashboard#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VexaMail/vexa-insight-dashboard.git"
  },
  "bugs": {
    "url": "https://github.com/VexaMail/vexa-insight-dashboard/issues"
  },
  "keywords": [
    "dmarc",
    "spf",
    "dkim",
    "email-authentication",
    "email-security",
    "observability",
    "deliverability",
    "self-hosted",
    "nextjs",
    "drizzle",
    "sqlite"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:dev": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write . --list-different",
    "format:check": "prettier --check .",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:a11y": "vitest run --config vitest.a11y.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "check": "pnpm run type-check && pnpm run format && pnpm run lint:fix",
    "check:all": "pnpm run type-check && pnpm run format && pnpm run lint:fix && pnpm run test",
    "check:ci": "pnpm run type-check && pnpm run lint && pnpm run format:check && pnpm run test",
    "perf:check": "pnpm build && lhci autorun --config=.lighthouserc.json"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.7.2",
    "framer-motion": "^12.38.0",
    "geoip-lite": "^2.0.1",
    "imapflow": "^1.3.2",
    "jsonrepair": "^3.14.0",
    "lucide-react": "^1.11.0",
    "mailparser": "^3.9.8",
    "next": "16.2.4",
    "node-cron": "^4.2.1",
    "react": "19.2.5",
    "react-country-flag": "^3.1.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.5",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "yauzl": "^3.3.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@tailwindcss/postcss": "^4.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/geoip-lite": "^1.4.4",
    "@types/node": "^25.6.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/yauzl": "^2.10.3",
    "better-sqlite3": "^12.9.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.2.1",
    "eslint-config-next": "16.2.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-code-policy": "^0.2.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-security": "^4.0.0",
    "eslint-plugin-sonarjs": "^4.0.3",
    "eslint-plugin-unicorn": "^64.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jiti": "^2.6.1",
    "jsdom": "^29.0.2",
    "prettier": "^3.8.3",
    "prettier-plugin-css-order": "^2.2.0",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.7.3",
    "tailwindcss": "^4.2.4",
    "ts-morph": "^28.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0",
    "vitest": "^4.1.5",
    "vitest-axe": "^0.1.0"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
